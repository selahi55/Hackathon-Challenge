{
  "manifest_version": 3,
  "name": "Your Bunq Mate",
  "version": "1.0",
  "description": "Your personal Bunq Mate to help you through everything!",
  "action": {
    "default_popup": "text.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "ws://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}